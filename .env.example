# Copiez ce fichier en .env puis renseignez vos identifiants.

# Email (SMTP) 
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=votre-adresse@gmail.com
EMAIL_HOST_PASSWORD=votre-mot-de-passe-application
DEFAULT_FROM_EMAIL=votre-adresse@gmail.com

# Pour développer sans envoyer d'email, utilisez la console :
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Celery 
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# false pour utiliser un vrai worker Redis ; true exécute les tâches en synchrone.
CELERY_TASK_ALWAYS_EAGER=false
